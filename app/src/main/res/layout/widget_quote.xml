<?xml version="1.0" encoding="utf-8"?>
<!-- Layers: pretty background, soft dark fade at the bottom, then the rude quote on top -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_sunset" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/quote_label"
            style="@style/WidgetText"
            android:layout_marginBottom="4dp"
            android:letterSpacing="0.15"
            android:text="@string/placeholder_label"
            android:textColor="@color/label"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/quote_text"
            style="@style/WidgetText"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="6"
            android:text="@string/placeholder_quote"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/quote_author"
            style="@style/WidgetText"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="2"
            android:text="@string/placeholder_author"
            android:textColor="@color/cream"
            android:textSize="13sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/quote_footer"
            style="@style/WidgetText"
            android:layout_marginTop="4dp"
            android:gravity="end"
            android:text="@string/footer"
            android:textColor="@color/soft_white"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
